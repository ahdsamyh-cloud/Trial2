[
  {
    "id": "tab-fault-detect",
    "type": "tab",
    "label": "Fault Detection",
    "disabled": false,
    "info": "Receives POSTs from the ESP32 and drives the Machine Health dashboard."
  },
  {
    "id": "ui-tab-health",
    "type": "ui_tab",
    "name": "Machine Health",
    "icon": "dashboard",
    "order": 1,
    "disabled": false,
    "hidden": false
  },
  {
    "id": "ui-group-vibration",
    "type": "ui_group",
    "name": "Vibration",
    "tab": "ui-tab-health",
    "order": 1,
    "disp": true,
    "width": 12,
    "collapse": false
  },
  {
    "id": "ui-group-env",
    "type": "ui_group",
    "name": "Environment",
    "tab": "ui-tab-health",
    "order": 2,
    "disp": true,
    "width": 6,
    "collapse": false
  },
  {
    "id": "ui-group-status",
    "type": "ui_group",
    "name": "Status",
    "tab": "ui-tab-health",
    "order": 3,
    "disp": true,
    "width": 6,
    "collapse": false
  },
  {
    "id": "http-in-vibration",
    "type": "http in",
    "z": "tab-fault-detect",
    "name": "POST /vibration",
    "url": "/vibration",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 150,
    "y": 140,
    "wires": [["fn-split", "chg-ack"]]
  },
  {
    "id": "chg-ack",
    "type": "change",
    "z": "tab-fault-detect",
    "name": "200 OK",
    "rules": [
      { "t": "set", "p": "statusCode", "pt": "msg", "to": "200", "tot": "num" },
      { "t": "set", "p": "payload", "pt": "msg", "to": "OK", "tot": "str" }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 400,
    "y": 100,
    "wires": [["http-response-ack"]]
  },
  {
    "id": "http-response-ack",
    "type": "http response",
    "z": "tab-fault-detect",
    "name": "Ack ESP32",
    "statusCode": "",
    "headers": {},
    "x": 610,
    "y": 100,
    "wires": []
  },
  {
    "id": "fn-split",
    "type": "function",
    "z": "tab-fault-detect",
    "name": "Split payload for dashboard",
    "func": "// msg.payload = { ts, s1:{vib_rms,vib_peak,baseline,fault}, s2:{...}, temp, hum, fault, fault_reason }\nconst p = msg.payload || {};\nconst ts = p.ts || Date.now();\n\nconst mpu1 = { topic: \"MPU1\", payload: { x: ts, y: (p.s1 && p.s1.vib_rms) || 0 } };\nconst mpu2 = { topic: \"MPU2\", payload: { x: ts, y: (p.s2 && p.s2.vib_rms) || 0 } };\n\nconst temp = { payload: p.temp };\nconst hum  = { payload: p.hum };\n\nconst faultText = {\n  payload: p.fault ? (\"FAULT: \" + p.fault_reason) : \"Normal\"\n};\nconst faultLed = { payload: p.fault ? 1 : 0 };\n\nreturn [mpu1, mpu2, temp, hum, faultText, faultLed];",
    "outputs": 6,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 200,
    "wires": [
      ["ui-chart-vib"],
      ["ui-chart-vib"],
      ["ui-gauge-temp"],
      ["ui-gauge-hum"],
      ["ui-text-fault"],
      ["ui-led-fault"]
    ]
  },
  {
    "id": "ui-chart-vib",
    "type": "ui_chart",
    "z": "tab-fault-detect",
    "name": "Vibration RMS",
    "group": "ui-group-vibration",
    "order": 1,
    "width": 0,
    "height": 0,
    "label": "Vibration RMS (m/s²)",
    "chartType": "line",
    "legend": "true",
    "xformat": "HH:mm:ss",
    "interpolate": "linear",
    "nodata": "",
    "dot": false,
    "ymin": "",
    "ymax": "",
    "removeOlderPoints": "",
    "removeOlderPointsUnit": "3600",
    "removeOlder": 1,
    "removeOlderUnit": "3600",
    "cutout": 0,
    "colors": ["#e5484d", "#3b82f6", "#f4c430", "#a3a3a3", "#9333ea"],
    "useOneColor": false,
    "useUTC": false,
    "x": 660,
    "y": 160,
    "wires": [[]]
  },
  {
    "id": "ui-gauge-temp",
    "type": "ui_gauge",
    "z": "tab-fault-detect",
    "name": "Temperature",
    "group": "ui-group-env",
    "order": 1,
    "width": 0,
    "height": 0,
    "gtype": "gage",
    "title": "Temperature",
    "label": "°C",
    "format": "{{value}}",
    "min": 0,
    "max": 60,
    "colors": ["#3b82f6", "#f4c430", "#e5484d"],
    "seg1": "30",
    "seg2": "45",
    "x": 660,
    "y": 220,
    "wires": []
  },
  {
    "id": "ui-gauge-hum",
    "type": "ui_gauge",
    "z": "tab-fault-detect",
    "name": "Humidity",
    "group": "ui-group-env",
    "order": 2,
    "width": 0,
    "height": 0,
    "gtype": "gage",
    "title": "Humidity",
    "label": "%",
    "format": "{{value}}",
    "min": 0,
    "max": 100,
    "colors": ["#3b82f6", "#f4c430", "#e5484d"],
    "seg1": "70",
    "seg2": "85",
    "x": 660,
    "y": 260,
    "wires": []
  },
  {
    "id": "ui-text-fault",
    "type": "ui_text",
    "z": "tab-fault-detect",
    "group": "ui-group-status",
    "order": 1,
    "width": 0,
    "height": 0,
    "name": "Fault status text",
    "label": "Status",
    "format": "{{msg.payload}}",
    "layout": "row-spread",
    "x": 660,
    "y": 300,
    "wires": []
  },
  {
    "id": "ui-led-fault",
    "type": "ui_led",
    "z": "tab-fault-detect",
    "name": "Fault indicator",
    "group": "ui-group-status",
    "order": 2,
    "width": 0,
    "height": 0,
    "label": "Fault",
    "labelPlacement": "left",
    "labelAlignment": "left",
    "shape": "circle",
    "colorForValue": [
      { "color": "#2ecc71", "value": "0", "valueType": "num" },
      { "color": "#e5484d", "value": "1", "valueType": "num" }
    ],
    "allowColorForValueInMessage": false,
    "x": 670,
    "y": 340,
    "wires": []
  }
]
