{
  "name": "stelco-ldms",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build && pnpm --filter api build && pnpm --filter web build",
    "build:shared": "pnpm --filter @ldms/shared build",
    "dev:api": "pnpm --filter api dev",
    "dev:worker": "pnpm --filter api dev:worker",
    "dev:web": "pnpm --filter web dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:int": "pnpm --filter api test:int",
    "test:e2e": "pnpm --filter web test:e2e",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:seed": "pnpm --filter api seed"
  }
}
