# Copy to apps/api/.env.test (git-ignored) for local integration tests. NO REAL VALUES.
# The database name must end in _test: the integration run drops and recreates its schema.
DATABASE_URL=postgresql://ldms_app:CHANGE_ME@localhost:5432/ldms_test
MIGRATION_DATABASE_URL=postgresql://ldms_owner:CHANGE_ME@localhost:5432/ldms_test
REDIS_URL=redis://localhost:6379/5
# Optional: DEMO_PASSWORD / DEMO_TOTP_SECRET / FIELD_KEYS / SIGNING_KEY are generated per run if unset.
