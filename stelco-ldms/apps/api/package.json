{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.tools.json",
    "dev": "node --env-file-if-exists=.env --watch -r @swc-node/register src/main.ts",
    "dev:worker": "node --env-file-if-exists=.env --watch -r @swc-node/register src/main.worker.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/main.worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run -c vitest.config.ts",
    "test:int": "vitest run -c vitest.int.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy && node scripts/apply-sql.js",
    "prisma:dev": "prisma migrate dev",
    "seed": "node -r @swc-node/register prisma/seed.ts",
    "start:local": "node --env-file-if-exists=.env dist/main.js",
    "seed:prod": "node dist-tools/prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1168.0",
    "@kenjiuno/msgreader": "1.29.0",
    "@ldms/shared": "workspace:*",
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@prisma/client": "6.19.3",
    "argon2": "0.41.1",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "diff": "7.0.0",
    "dompurify": "3.4.17",
    "exceljs": "4.4.0",
    "express": "5.1.0",
    "helmet": "8.0.0",
    "ics": "3.8.1",
    "ioredis": "5.11.1",
    "jsdom": "25.0.1",
    "mailparser": "3.14.3",
    "mammoth": "1.13.0",
    "multer": "2.5.0",
    "nodemailer": "10.5.0",
    "otplib": "12.0.1",
    "pdf-lib": "1.17.1",
    "pg": "8.13.1",
    "pino": "9.5.0",
    "prisma": "6.19.3",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@swc-node/register": "1.10.9",
    "@swc/core": "1.15.3",
    "@types/cookie-parser": "1.4.8",
    "@types/diff": "6.0.0",
    "@types/express": "5.0.0",
    "@types/jsdom": "21.1.7",
    "@types/mailparser": "3.4.5",
    "@types/multer": "1.4.12",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.11.10",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.1",
    "vitest": "3.2.7"
  }
}
