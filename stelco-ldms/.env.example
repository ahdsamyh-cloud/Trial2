# STELCO LDMS — example configuration. NO REAL VALUES. Copy to .env for local development only.
# In staging/production inject these from Vault or deploy-time secrets (see docs/IT_SETUP.md).

NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
# Behind the reverse proxy over HTTPS this MUST be true (enables __Host- cookies and Secure flag)
COOKIE_SECURE=false
TRUST_PROXY=1

# Runtime role (no DDL, no UPDATE/DELETE on AuditLog). Owner role is only used for migrations.
DATABASE_URL=postgresql://ldms_app:CHANGE_ME@localhost:5432/ldms?sslmode=disable
MIGRATION_DATABASE_URL=postgresql://ldms_owner:CHANGE_ME@localhost:5432/ldms?sslmode=disable
APP_DB_ROLE=ldms_app
REDIS_URL=redis://localhost:6379

SESSION_IDLE_MIN=15
SESSION_IDLE_MOBILE_MIN=5
SESSION_ABS_HOURS=8
REAUTH_WINDOW_MIN=5

# Field-level encryption keyring: id:base64(32 random bytes)[,id2:...]  (openssl rand -base64 32)
FIELD_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
FIELD_KEY_ACTIVE=k1
# HMAC key for signed download links / CSRF (openssl rand -base64 48)
SIGNING_KEY=REPLACE_WITH_BASE64_48_BYTES_REPLACE_WITH_BASE64_48_BYTES

# Storage: fs (dev) or s3 (MinIO / SeaweedFS / Garage / Ceph RGW)
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=./var/storage
S3_ENDPOINT=https://objects.internal:9000
S3_REGION=us-east-1
S3_BUCKET=ldms-documents
S3_QUARANTINE_BUCKET=ldms-quarantine
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_SSE=false

AV_MODE=clamd
CLAMD_HOST=localhost
CLAMD_PORT=3310
MAX_UPLOAD_MB=50
OCR_ENABLED=false
OCR_MAX_PAGES=50

SMTP_ENABLED=false
SMTP_HOST=smtp-relay.internal
SMTP_PORT=25
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_FROM=LDMS <no-reply-legal@stelco.com.mv>

# Optional: comma-separated IPv4 CIDRs allowed to use admin functions (office network)
ADMIN_IP_ALLOWLIST=
# Optional: larger offline breached-password list, one per line
BREACHED_PASSWORDS_FILE=
GOTENBERG_URL=http://gotenberg:3000
LOG_LEVEL=info
LOGIN_DELAY_BASE_MS=1000

# Dev/demo only
SEED_DEMO=false
DEMO_PASSWORD=
DEMO_TOTP_SECRET=
